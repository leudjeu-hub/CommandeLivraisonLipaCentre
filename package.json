{
  "name": "commande-livraison-lipacentre",
  "version": "0.1.0",
  "private": true,
  "description": "Page de commande et de livraison de la Librairie Papeterie du Centre (Yaoundé)",
  "scripts": {
    "dev": "node scripts/catalogue-api.cjs && node scripts/serve.cjs src",
    "dev:csv": "node scripts/catalogue.cjs && node scripts/serve.cjs src",
    "catalogue": "node scripts/catalogue.cjs",
    "build": "node scripts/catalogue.cjs && node scripts/build.cjs",
    "start": "npm run build && node scripts/serve.cjs dist",
    "pretest": "node scripts/catalogue.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test"
  },
  "author": "Alain Bienvenu Leudjeu",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@opencode/cli": "^2.0.32"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {}
}
